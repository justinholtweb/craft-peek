{
    "name": "justinholtweb/craft-peek",
    "description": "Content staging, visual diff, and coordinated releases for Craft CMS.",
    "version": "6.0.0-beta.1",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "drafts",
        "diff",
        "releases",
        "content-staging",
        "laravel"
    ],
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://github.com/justinholtweb"
        }
    ],
    "support": {
        "email": "justin@justinholtweb.com",
        "issues": "https://github.com/justinholtweb/craft-peek/issues",
        "source": "https://github.com/justinholtweb/craft-peek",
        "docs": "https://github.com/justinholtweb/craft-peek/blob/6.0.0/README.md"
    },
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1",
        "jfcherng/php-diff": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "JustinHoltWeb\\Peek\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustinHoltWeb\\Peek\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-cs": "pint --test",
        "fix-cs": "pint"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.5"
        },
        "sort-packages": true
    },
    "extra": {
        "name": "Peek",
        "handle": "peek",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "developerEmail": "justin@justinholtweb.com",
        "description": "Content staging, visual diff, and coordinated releases for Craft CMS.",
        "documentationUrl": "https://github.com/justinholtweb/craft-peek/blob/6.0.0/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-peek/6.0.0/CHANGELOG.md",
        "class": "JustinHoltWeb\\Peek\\Plugin"
    }
}
