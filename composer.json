{
    "name": "justinholtweb/craft-peek",
    "description": "Content staging, visual diff, and coordinated releases for Craft CMS.",
    "version": "5.0.2",
    "type": "craft-plugin",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "jfcherng/php-diff": "^6.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "codeception/module-yii2": "^1.1",
        "codeception/module-asserts": "^3.0",
        "codeception/module-datafactory": "^3.0",
        "vlucas/phpdotenv": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\peek\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\peek\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "codecept run",
        "test-unit": "codecept run unit",
        "test-integration": "codecept run integration",
        "ecs": "ecs check",
        "ecs-fix": "ecs check --fix",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "support": {
        "email": "justin@justinholtweb.com",
        "issues": "https://github.com/justinholtweb/craft-peek/issues",
        "docs": "https://github.com/justinholtweb/craft-peek/blob/main/README.md"
    },
    "extra": {
        "handle": "peek",
        "name": "Peek",
        "developer": "justinholtweb",
        "developerUrl": "https://justinholt.com",
        "developerEmail": "justin@justinholtweb.com",
        "documentationUrl": "https://github.com/justinholtweb/craft-peek",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-peek/main/CHANGELOG.md",
        "description": "Content staging, visual diff, and coordinated releases for Craft CMS.",
        "class": "justinholtweb\\peek\\Plugin",
        "schemaVersion": "1.0.0",
        "hasCpSettings": true,
        "hasCpSection": true
    }
}
