{% extends 'peek/_layouts/plugin' %}
{% import '_includes/forms.twig' as forms %}

{% set title = title ?? 'New Release'|t('peek') %}
{% set selectedSubnavItem = 'releases' %}
{# A publishing or published release is history: no form, no Save button. #}
{% set fullPageForm = editable ?? true %}

{% do view.registerAssetBundle('justinholtweb\\peek\\web\\assets\\cp\\CpAsset') %}

{% block pluginContent %}
    <input type="hidden" name="action" value="peek/releases/save">
    {{ redirectInput('peek/releases/{id}') }}

    {% if release.id %}
        <input type="hidden" name="releaseId" value="{{ release.id }}">
    {% endif %}

    <input type="hidden" name="siteId" value="{{ release.siteId ?? currentSite.id }}">

    <div id="fields">
        {{ forms.textField({
            label: 'Release Name'|t('peek'),
            instructions: 'A descriptive name for this release.'|t('peek'),
            id: 'name',
            name: 'name',
            value: release.name,
            required: true,
            first: true,
            errors: release.getErrors('name'),
        }) }}

        {{ forms.textareaField({
            label: 'Description'|t('peek'),
            instructions: 'Optional release notes or description.'|t('peek'),
            id: 'description',
            name: 'description',
            value: release.description,
            rows: 3,
        }) }}

        {{ forms.selectField({
            label: 'Status'|t('peek'),
            id: 'status',
            name: 'status',
            value: release.status.value,
            options: [
                { label: 'Draft'|t('peek'), value: 'draft' },
                { label: 'Ready'|t('peek'), value: 'ready' },
            ]|merge(currentUser.can('peek:scheduleReleases') or release.status.value == 'scheduled'
                ? [{ label: 'Scheduled'|t('peek'), value: 'scheduled' }]
                : []),
            disabled: not editable,
        }) }}

        {{ forms.dateTimeField({
            label: 'Scheduled Date'|t('peek'),
            instructions: 'When to automatically publish this release.'|t('peek'),
            id: 'scheduledDate',
            name: 'scheduledDate',
            value: release.scheduledDate,
            errors: release.getErrors('scheduledDate'),
            disabled: not editable,
        }) }}

        {% if release.getErrors('entries') %}
            {{ forms.errorList(release.getErrors('entries')) }}
        {% endif %}
    </div>

    {# Entries in this release #}
    {% if release.id %}
        <hr>
        <h2>{{ 'Entries in Release'|t('peek') }} ({{ resolvedEntries|length }})</h2>

        {% if resolvedEntries|length %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Entry'|t('peek') }}</th>
                        <th>{{ 'Section'|t('peek') }}</th>
                        <th>{{ 'Status'|t('peek') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in resolvedEntries %}
                        <tr>
                            <td>
                                {% if item.draft %}
                                    <a href="{{ item.draft.cpEditUrl }}">{{ item.title }}</a>
                                    <span class="light"> — {{ 'Draft'|t('peek') }}</span>
                                {% elseif item.canonical %}
                                    <a href="{{ item.canonical.cpEditUrl }}">{{ item.title }}</a>
                                    {% if item.releaseEntry.status == 'published' %}
                                        <span class="light"> — {{ 'Applied'|t('peek') }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="light">{{ item.title }}</span>
                                {% endif %}
                            </td>
                            <td>{{ item.section }}</td>
                            <td>
                                {% if item.releaseEntry.status == 'published' %}
                                    <span class="status green"></span> {{ 'Published'|t('peek') }}
                                {% elseif item.releaseEntry.status == 'failed' %}
                                    <span class="status red"></span> {{ 'Failed'|t('peek') }}
                                {% else %}
                                    <span class="status"></span> {{ 'Pending'|t('peek') }}
                                {% endif %}
                            </td>
                            <td class="thin">
                                {% if item.releaseEntry.draftId and item.releaseEntry.status == 'pending' %}
                                    <div class="flex">
                                        {% if item.draft and currentUser.can('peek:viewDiffs') %}
                                            <a href="{{ url('peek/diff/' ~ item.releaseEntry.draftId) }}" class="btn small">{{ 'Diff'|t('peek') }}</a>
                                        {% endif %}
                                        {# The whole page is one form (fullPageForm), so secondary actions are
                                           formsubmit buttons — a nested <form> is dropped by the browser and its
                                           action input lands in the main form, where the last one wins. #}
                                        {% if editable %}
                                            <button type="button" class="btn small formsubmit"
                                                data-action="peek/releases/remove-entry"
                                                data-params="{{ { draftId: item.releaseEntry.draftId }|json_encode }}"
                                                data-redirect="{{ ('peek/releases/' ~ release.id)|hash }}">{{ 'Remove'|t('peek') }}</button>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p class="light">{{ 'No entries added to this release yet.'|t('peek') }}</p>
        {% endif %}

        {% if editable %}
            {% if addableDrafts|length %}
                <div class="flex mt-m">
                    {{ forms.select({
                        id: 'addDraftId',
                        name: 'addDraftId',
                        options: [{ label: 'Choose a draft…'|t('peek'), value: '' }]|merge(addableDrafts|map(d => {
                            label: (d.title ?? ('#' ~ d.id)) ~ ' — ' ~ (d.draftName ?? 'Draft'|t('peek')) ~ ' (' ~ d.section.name ~ ')',
                            value: d.id,
                        })),
                    }) }}
                    <button type="button" class="btn formsubmit"
                        data-action="peek/releases/add-entry"
                        data-redirect="{{ ('peek/releases/' ~ release.id)|hash }}">{{ 'Add to Release'|t('peek') }}</button>
                </div>
            {% else %}
                <p class="light mt-m">{{ 'There are no other drafts you can add. A draft can be added by anyone who could publish it.'|t('peek') }}</p>
            {% endif %}
        {% endif %}

        {# Publish / Delete actions #}
        {% if release.status.value not in ['published', 'publishing'] %}
            <hr>
            <div class="peek-release-actions">
                {% if currentUser.can('peek:publishReleases') %}
                    <button type="button" class="btn submit formsubmit"
                        data-action="peek/releases/publish"
                        data-confirm="{{ 'Publish every draft in this release now?'|t('peek') }}"
                        data-redirect="{{ ('peek/releases/' ~ release.id)|hash }}">{{ 'Publish Now'|t('peek') }}</button>
                {% endif %}

                {% if currentUser.can('peek:deleteReleases') %}
                    <button type="button" class="btn formsubmit"
                        data-action="peek/releases/delete"
                        data-confirm="{{ 'Are you sure you want to delete this release?'|t('peek') }}"
                        data-redirect="{{ 'peek/releases'|hash }}">{{ 'Delete'|t('peek') }}</button>
                {% endif %}
            </div>
        {% endif %}

        {# Published release info #}
        {% if release.status.value == 'published' %}
            <hr>
            <div class="peek-published-info">
                <p class="light">
                    {{ 'Published on {date}'|t('peek', { date: release.publishedDate|date('M j, Y g:i A') }) }}
                </p>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
