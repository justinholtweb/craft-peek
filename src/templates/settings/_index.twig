{% extends 'peek/_layouts/plugin' %}
{% import '_includes/forms.twig' as forms %}

{% set title = 'Peek Settings'|t('peek') %}
{% set selectedSubnavItem = 'settings' %}
{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% block pluginContent %}
    <input type="hidden" name="action" value="peek/settings/save">
    {{ redirectInput('peek/settings') }}

    {% if readOnly %}
        <p class="warning with-icon">{{ 'Settings can only be changed where admin changes are allowed. They come from project config here.'|t('peek') }}</p>
    {% endif %}

    <div id="fields">
        <h2>{{ 'Navigation'|t('peek') }}</h2>

        {{ forms.textField({
            label: 'Sidebar label'|t('peek'),
            instructions: 'The name of the Peek item in the control panel sidebar. Leave blank to use “Peek”.'|t('peek'),
            id: 'navLabel',
            name: 'navLabel',
            value: settings.navLabel,
            placeholder: 'Peek',
            maxlength: 64,
            errors: settings.getErrors('navLabel'),
        }) }}

        {{ forms.iconPickerField({
            label: 'Sidebar icon'|t('peek'),
            instructions: 'An icon from Craft’s icon set.'|t('peek'),
            id: 'navIcon',
            name: 'navIcon',
            value: settings.navIcon,
            errors: settings.getErrors('navIcon'),
        }) }}

        {{ forms.textareaField({
            label: 'Custom sidebar icon (SVG)'|t('peek'),
            instructions: 'Paste a single `<svg>` element to use instead of the icon above. It is sanitized before it is shown: scripts, event handlers and external references are removed.'|t('peek'),
            id: 'navIconSvg',
            name: 'navIconSvg',
            value: settings.navIconSvg,
            class: 'code',
            rows: 4,
            errors: settings.getErrors('navIconSvg'),
        }) }}

        <p class="light smalltext">{{ 'A control panel navigation plugin, or Craft’s own navigation editor where it has one, overrides these.'|t('peek') }}</p>

        <hr>

        <h2>{{ 'General'|t('peek') }}</h2>

        {{ forms.textField({
            label: 'Stale Draft Days'|t('peek'),
            instructions: 'Number of days before a draft is considered stale.'|t('peek'),
            id: 'staleDraftDays',
            name: 'staleDraftDays',
            value: settings.staleDraftDays,
            type: 'number',
            min: 1,
            errors: settings.getErrors('staleDraftDays'),
        }) }}

        {{ forms.lightswitchField({
            label: 'Enable Visual Preview'|t('peek'),
            instructions: 'Show side-by-side iframe preview in the diff view.'|t('peek'),
            id: 'enableVisualPreview',
            name: 'enableVisualPreview',
            on: settings.enableVisualPreview,
        }) }}

        <hr>

        <h2>{{ 'Releases'|t('peek') }}</h2>

        {{ forms.textField({
            label: 'Max Entries Per Release'|t('peek'),
            instructions: 'Maximum number of entries that can be added to a single release.'|t('peek'),
            id: 'maxEntriesPerRelease',
            name: 'maxEntriesPerRelease',
            value: settings.maxEntriesPerRelease,
            type: 'number',
            min: 1,
            max: 500,
        }) }}
    </div>
{% endblock %}
